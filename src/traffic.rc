/////////////////////////////////////////////////////////////////////////////
//
// Menu
//

IDR_MAINFRAME MENU 
BEGIN
    POPUP "文件"
    BEGIN
        MENUITEM "新建",                          ID_FILE_NEW
        MENUITEM "打开路网",                        ID_FILE_OPEN
        MENUITEM "保存",                          ID_FILE_SAVE
        MENUITEM "另存为",                         ID_FILE_SAVE_AS
        MENUITEM SEPARATOR
        MENUITEM "最近文件",                        ID_FILE_MRU_FILE1
        MENUITEM SEPARATOR
        MENUITEM "退出",                          ID_APP_EXIT
    END
    POPUP "编辑"
    BEGIN
        MENUITEM "撤消",                          ID_EDIT_UNDO
        MENUITEM SEPARATOR
        MENUITEM "剪切",                          ID_EDIT_CUT
        MENUITEM "复制",                          ID_EDIT_COPY
        MENUITEM "粘贴",                          ID_EDIT_PASTE
    END
    POPUP "运行"
    BEGIN
        MENUITEM "开始/暂停",                       ID_RUN
        MENUITEM "终止",                          ID_APP_EXIT
    END
    POPUP "视图"
    BEGIN
        MENUITEM "放大",                          ID_ZOOMIN
        MENUITEM "缩小",                          ID_ZOOMOUT
        MENUITEM SEPARATOR
        MENUITEM "移动",                          ID_MOVE
    END
    POPUP "工具"
    BEGIN
        MENUITEM "诱导信息",                        ID_SWITCH_GUIDANCE
        POPUP "控制信息"
        BEGIN
            MENUITEM "单点控制",                        ID_SWITCH_POINT_CONTROL
            MENUITEM "区域控制",                        ID_SWITCH_REGION_CONTROL
        END
        MENUITEM "检测器",                         ID_SWITCH_DETECTOR
    END
    POPUP "查看"
    BEGIN
        MENUITEM "工具栏",                         ID_VIEW_TOOLBAR
        MENUITEM "状态栏",                         ID_VIEW_STATUS_BAR
        MENUITEM SEPARATOR
        MENUITEM "仿真数据",                        ID_SHOW_DATA
        MENUITEM "设备状态",                        ID_CG_STATEMENT
        MENUITEM "控制策略",                        ID_CONTROL_VIEW
        MENUITEM "诱导策略",                        ID_GUIDANCE_VIEW
        MENUITEM SEPARATOR
        MENUITEM "流量统计",                        ID_PLOT_DATA_ON_ROAD
        MENUITEM "MFD",                         ID_PLOT_MFD
    END
    POPUP "高级"
    BEGIN
        MENUITEM "信号灯设置",                       ID_32812
        MENUITEM "检测器设置",                       ID_32813
        MENUITEM "诱导信息板设置",                     ID_32814
        MENUITEM SEPARATOR
        MENUITEM "仿真步长设置",                      ID_MODIFY_SIMU_LENGTH
        MENUITEM SEPARATOR
        MENUITEM "其它",                          ID_32816
    END
    POPUP "帮助"
    BEGIN
        MENUITEM "使用手册",                        ID_32819
        MENUITEM "检查更新",                        ID_32820
        MENUITEM SEPARATOR
        MENUITEM "关于 UTSS",                     ID_APP_ABOUT
    END
END


