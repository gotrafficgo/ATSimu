IDD_DLG_SETTING DIALOGEX 0, 0, 159, 213
STYLE DS_SETFONT | DS_MODALFRAME | DS_FIXEDSYS | DS_CENTER | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Setting"
FONT 8, "MS Shell Dlg", 400, 0, 0x1
BEGIN
    CONTROL         "",IDC_SIMU_SPEED,"msctls_trackbar32",TBS_BOTH | TBS_NOTICKS | WS_TABSTOP,16,80,120,15
    CONTROL         "",IDC_SLIDER_DEMAND,"msctls_trackbar32",TBS_BOTH | TBS_NOTICKS | WS_GROUP | WS_TABSTOP,18,165,93,15
    EDITTEXT        IDC_SHOW_VALUE,129,167,20,12,ES_AUTOHSCROLL
    GROUPBOX        "Simulation speed",IDC_STATIC,7,59,145,47
    LTEXT           "Time interval",IDC_STATIC,23,69,46,8
    GROUPBOX        "Demand",IDC_STATIC,7,115,145,91
    LTEXT           "The number of vehs generated by one origin in 1 min",IDC_STATIC,21,185,118,21
    LTEXT           "Static",IDC_MIN_VALUE,12,167,8,13
    LTEXT           "Static",IDC_MAX_VALUE,108,167,16,13
    GROUPBOX        "Simulation Start Time",IDC_STATIC,7,7,145,48
    LTEXT           "Hour",IDC_STATIC,48,20,17,11
    LTEXT           "Min",IDC_STATIC,74,20,17,11
    LTEXT           "Sec",IDC_STATIC,97,20,17,11
    EDITTEXT        IDC_HOUR,45,33,20,13,ES_AUTOHSCROLL
    EDITTEXT        IDC_MINUTE,69,33,20,13,ES_AUTOHSCROLL
    EDITTEXT        IDC_SECOND,93,33,20,13,ES_AUTOHSCROLL
